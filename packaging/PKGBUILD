# Arch Linux PKGBUILD for engram (Steelbore Standard §5.5).
# Builds the tagged v0.6.0 release tarball.

pkgname=engram
pkgver=0.6.0
pkgrel=1
pkgdesc="Shared verbatim chat memory for multi-model LLM pipelines (SQLite FTS5; CLI, MCP, HTTP)"
arch=('x86_64' 'aarch64')
url="https://Engram.SpacecraftSoftware.org/"
license=('GPL-3.0-or-later')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Spacecraft-Software/Engram/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('fdc75576d846985a1d54609cbcfc2297b3b5c2a9e312ec7e6d17074bd3a04915')

build() {
  cd "Engram-$pkgver"
  cargo build --release --locked
}

package() {
  cd "Engram-$pkgver"
  install -Dm755 "target/release/engram" "$pkgdir/usr/bin/engram"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
